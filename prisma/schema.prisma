generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  OWNER
  ADMIN
}

enum QuoteRequestStatus {
  NOVA
  EM_ANALISE
  PROPOSTA_ENVIADA
  APROVADA
  RECUSADA
  CANCELADA
}

enum EventStatus {
  PLANEJAMENTO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  APROVADA
  RECUSADA
  CANCELADA
}

enum ProposalPricingMode {
  ITEMIZED
  PER_GUEST
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_DENIED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  GOOGLE_LOGIN_SUCCESS
  GOOGLE_LOGIN_DENIED
}

model AdminUser {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String?
  googleId           String?   @unique
  avatarUrl          String?
  role               AdminRole @default(ADMIN)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?
  version            Int       @default(1)

  sessions            AdminSession[]
  passwordResetTokens PasswordResetToken[]
  authEvents          AuthAuditEvent[]
  responsibleProposals Proposal[] @relation("ProposalResponsible")

  @@index([email])
  @@index([isActive])
}

model AdminSession {
  id             String    @id @default(cuid())
  adminUserId    String
  tokenHash      String    @unique
  csrfTokenHash  String
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AuthAuditEvent {
  id          String        @id @default(cuid())
  adminUserId String?
  type        AuthEventType
  email       String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([type])
  @@index([createdAt])
}

model QuoteRequest {
  id                  String   @id @default(cuid())
  fullName            String
  email               String?
  phone               String
  eventType           String
  eventTypeOther      String?
  eventDate           DateTime?
  eventTime           String?
  guestCount          Int
  location            String?
  message             String?
  preferredContact    String
  menuPreferences     Json?
  serviceNeeds        Json?
  dietaryRestrictions String?
  acceptedPrivacy     Boolean
  source              String   @default("public_site")
  status              QuoteRequestStatus @default(NOVA)
  customerId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  event               Event?
  proposals           Proposal[]
  menuSelections      QuoteRequestMenuSelection[]

  @@index([createdAt])
  @@index([eventType])
  @@index([status])
  @@index([customerId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteRequests QuoteRequest[]
  events        Event[]
  proposals     Proposal[]

  @@unique([email, phone])
  @@index([name])
  @@index([phone])
}

model Event {
  id             String      @id @default(cuid())
  customerId     String
  quoteRequestId String?     @unique
  eventType      String
  eventDate      DateTime
  eventTime      String
  location       String
  guestCount     Int
  notes          String?
  status         EventStatus @default(PLANEJAMENTO)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id])
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  proposals    Proposal[]

  @@index([customerId])
  @@index([eventDate])
  @@index([status])
}

model Proposal {
  id              String         @id @default(cuid())
  customerId      String
  eventId         String?
  quoteRequestId  String?
  description     String?
  notes           String?
  validUntil      DateTime
  status          ProposalStatus @default(RASCUNHO)
  subtotalCents   Int            @default(0)
  adjustmentCents Int            @default(0)
  totalCents      Int            @default(0)
  pricingMode     ProposalPricingMode @default(ITEMIZED)
  guestCount      Int?
  pricePerGuestCents Int?
  baseTotalCents  Int?
  responsibleAdminId String?
  responsibleNameSnapshot String?
  responsibleTitleSnapshot String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id])
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  items        ProposalItem[]
  includedServices ProposalIncludedService[]
  paymentInstallments ProposalPaymentInstallment[]
  menuSelections ProposalMenuSelection[]
  paymentMethods ProposalPaymentMethod[]
  responsibleAdmin AdminUser? @relation("ProposalResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([eventId])
  @@index([quoteRequestId])
  @@index([status])
  @@index([validUntil])
  @@index([responsibleAdminId])
}

model ProposalItem {
  id               String   @id @default(cuid())
  proposalId       String
  description      String
  quantity         Int
  unitPriceCents   Int
  subtotalCents    Int
  position         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, position])
  @@index([proposalId])
}

model MenuSelectionGroup {
  id            String   @id @default(cuid())
  name          String   @unique
  minSelections Int      @default(0)
  maxSelections Int?
  position      Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections MenuSection[]

  @@index([position])
  @@index([isActive])
}

model MenuSection {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   MenuSelectionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  options MenuOption[]

  @@unique([groupId, name])
  @@index([groupId, position])
  @@index([isActive])
}

model MenuOption {
  id        String   @id @default(cuid())
  sectionId String
  name      String
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section        MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quoteSelections QuoteRequestMenuSelection[]

  @@unique([sectionId, name])
  @@index([sectionId, position])
  @@index([isActive])
}

model QuoteRequestMenuSelection {
  id              String   @id @default(cuid())
  quoteRequestId  String
  menuOptionId    String?
  groupName       String
  groupPosition   Int
  sectionName     String
  sectionPosition Int
  optionName      String
  optionPosition  Int
  createdAt       DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  menuOption   MenuOption?  @relation(fields: [menuOptionId], references: [id], onDelete: Restrict)

  @@unique([quoteRequestId, menuOptionId])
  @@index([quoteRequestId, groupPosition, sectionPosition, optionPosition], map: "QuoteRequestMenuSelection_quoteRequestId_groupPosition_sectionP")
  @@index([menuOptionId])
}

model PaymentMethod {
  id           String   @id @default(cuid())
  name         String   @unique
  instructions String?
  pixKey       String?
  position     Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proposalSnapshots ProposalPaymentMethod[]

  @@index([position])
  @@index([isActive])
}

model ProposalIncludedService {
  id          String   @id @default(cuid())
  proposalId  String
  description String
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, position])
  @@index([proposalId])
}

model ProposalMenuSelection {
  id              String   @id @default(cuid())
  proposalId      String
  groupName       String
  groupPosition   Int
  sectionName     String
  sectionPosition Int
  optionName      String
  optionPosition  Int
  createdAt       DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, groupPosition, sectionPosition, optionPosition], map: "ProposalMenuSelection_order_key")
  @@index([proposalId, groupPosition, sectionPosition, optionPosition], map: "ProposalMenuSelection_order_idx")
}

model ProposalPaymentMethod {
  id              String   @id @default(cuid())
  proposalId      String
  paymentMethodId String
  name            String
  instructions    String?
  pixKey          String?
  position        Int
  createdAt       DateTime @default(now())

  proposal      Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@unique([proposalId, paymentMethodId])
  @@unique([proposalId, position])
  @@index([proposalId])
  @@index([paymentMethodId])
}

model ProposalPaymentInstallment {
  id          String   @id @default(cuid())
  proposalId  String
  description String
  percentage  Int
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, position])
  @@index([proposalId])
}
